        <mxCell id="5abUMghdAwLiTRaKQoQl-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Definimos un caso de uso como la &lt;b&gt;interacción&lt;/b&gt; entre un &lt;b&gt;actor&lt;/b&gt; y el &lt;b&gt;sistema&lt;/b&gt; para lograr un objetivo (provee valor a un actor)" vertex="1">
