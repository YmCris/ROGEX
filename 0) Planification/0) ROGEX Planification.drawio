        <mxCell id="ols7WJPwoKZh_aUgvy9h-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Definimos un diagrama de casos de uso&amp;nbsp;como una&amp;nbsp; representación visual que muestra las interacciones entre actores externos y el sistema." vertex="1">
          <mxGeometry height="60" width="430" x="-96" y="-777" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="Un caso de uso es un caso de uso si y solo sí tiene:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Un Actor&lt;/li&gt;&lt;li&gt;Un Objetivo específico&lt;/li&gt;&lt;li&gt;Interacción con el sistema&lt;/li&gt;&lt;li&gt;Resultado Observable&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="430" x="-86" y="-667" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Un actor es un usuario, otro sistema, servicio externo&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, proceso autómatico, etc, que obtiene un beneficio del sistema&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="430" x="384" y="-777" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="Actores en el programa&lt;div&gt;&lt;ul&gt;&lt;li&gt;Administrador del Sistema&lt;/li&gt;&lt;li&gt;Empresa Desarrolladora&lt;/li&gt;&lt;li&gt;Usuario de Empresa&lt;/li&gt;&lt;li&gt;Usuario final&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="430" x="404" y="-667" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;1) DEFINIMOS &quot;DIAGRAMA DE CASOS DE USO&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="-96" y="-877" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;2) DEFINIMOS ACTORES&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="344" y="-877" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;0) DEFINIMOS LA ESTRUCTURA DEL DOCUMENTO&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="-556" y="-866" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Cada índice (&quot;0)&quot;,&quot;1)&quot;,...) indicará pasos para com-&lt;div&gt;prender la estructura del documento.&lt;/div&gt;&lt;div&gt;Seguido de eso se encontrará una descripción del paso.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="430" x="-561" y="-746" as="geometry" />
        </mxCell>
        <mxCell id="ols7WJPwoKZh_aUgvy9h-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;3) DEFINIMOS LOS COMPONENTES&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="640" x="906" y="-1033.83" as="geometry" />
        </mxCell>
        <mxCell id="StGt508rEaj9xoojM9PV-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="System" vertex="1">
          <mxGeometry height="140" width="340" x="1190" y="-913.83" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;asociación&lt;/b&gt;&lt;div&gt;Este actor ejecuta este acaso de uso&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="938.5" y="-686" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/b&gt;&lt;div&gt;Un caso de uso necesariamente ejecuta otro&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="1165" y="-686" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;extend&lt;/b&gt;&lt;br&gt;&lt;div&gt;Un caso de uso opcional o condicional agrega comportamiento adicional a otro&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="1407.7" y="-690" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li data-start=&quot;964&quot; data-end=&quot;1000&quot;&gt;&lt;p data-start=&quot;966&quot; data-end=&quot;1000&quot;&gt;Es &lt;strong data-start=&quot;969&quot; data-end=&quot;984&quot;&gt;obligatorio&lt;/strong&gt;, no opcional.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1001&quot; data-end=&quot;1058&quot;&gt;&lt;p data-start=&quot;1003&quot; data-end=&quot;1058&quot;&gt;Se usa para &lt;strong data-start=&quot;1015&quot; data-end=&quot;1039&quot;&gt;evitar repetir pasos&lt;/strong&gt; en varios casos.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1059&quot; data-end=&quot;1130&quot;&gt;&lt;p data-start=&quot;1061&quot; data-end=&quot;1130&quot;&gt;El caso de uso incluido es &lt;strong data-start=&quot;1088&quot; data-end=&quot;1109&quot;&gt;parte obligatoria&lt;/strong&gt; del flujo principal.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="100" width="184" x="1183" y="-672" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li data-start=&quot;964&quot; data-end=&quot;1000&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El caso que extiende &lt;/span&gt;&lt;strong data-start=&quot;1992&quot; data-end=&quot;2032&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;solo ocurre bajo ciertas condiciones&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li data-start=&quot;2036&quot; data-end=&quot;2093&quot;&gt;&lt;p data-start=&quot;2038&quot; data-end=&quot;2093&quot;&gt;El caso principal &lt;strong data-start=&quot;2056&quot; data-end=&quot;2090&quot;&gt;se entiende bien sin el extend.&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2094&quot; data-end=&quot;2128&quot;&gt;&lt;p data-start=&quot;2096&quot; data-end=&quot;2128&quot;&gt;El extend &lt;strong data-start=&quot;2106&quot; data-end=&quot;2127&quot;&gt;no es obligatorio&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="100" width="184" x="1421.7" y="-650" as="geometry" />
        </mxCell>
        <mxCell id="dkUvN3bs9mGVLo8buirp-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;herencia&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor hijo hereda los CU del actor padre&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Especializar casos de uso&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="1636" y="-700" as="geometry" />
        </mxCell>
